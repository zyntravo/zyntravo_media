*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, sans-serif;
}


body{

background:#f7f7f7;
color:#222;

}


/* Header */

header{

background:#111;
color:white;
padding:20px;
display:flex;
justify-content:space-between;
align-items:center;
flex-wrap:wrap;

}


.logo{

font-size:25px;
font-weight:bold;

}


nav a{

color:white;
text-decoration:none;
margin:10px;

}



/* Search */

.search-box{

padding:20px;
text-align:center;

}


.search-box input{

width:90%;
max-width:500px;
padding:15px;
border-radius:25px;
border:1px solid #ddd;
font-size:16px;

}



/* Hero */

.hero{

background:white;
padding:60px 20px;
text-align:center;

}


.hero h1{

font-size:40px;

}


.hero p{

margin:15px;

}


.hero button{

background:#ff9900;
color:white;
border:none;
padding:14px 30px;
border-radius:30px;
font-size:16px;

}



/* Heading */

h2{

text-align:center;
margin:30px 0;

}



/* Category */

.categories{

display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;

}


.categories div{

background:white;
padding:25px;
border-radius:15px;
box-shadow:0 5px 15px #ddd;

}



/* Products */

.product-container{

display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
padding:20px;

}


.product-card{

background:white;
padding:15px;
border-radius:15px;
box-shadow:0 5px 20px #ddd;
transition:.3s;

}


.product-card:hover{

transform:translateY(-8px);

}


.product-card img{

width:100%;
height:220px;
object-fit:cover;
border-radius:10px;

}


.badge{

background:#ff5722;
color:white;
padding:6px 12px;
border-radius:20px;
font-size:13px;

}


.rating{

margin:10px 0;

}


.old-price{

text-decoration:line-through;
color:#888;

}


.sale-price{

color:#e91e63;
font-size:22px;
font-weight:bold;

}


.product-card button{

width:100%;
padding:12px;
margin-top:15px;
border:none;
background:#ff9900;
color:white;
border-radius:25px;
cursor:pointer;

}



/* Blog */

.blog-container{

display:flex;
gap:20px;
padding:20px;

}


.blog-card{

background:white;
padding:20px;
border-radius:15px;
box-shadow:0 5px 15px #ddd;

}



/* Trust */

.trust{

display:flex;
justify-content:center;
gap:20px;
padding:30px;
flex-wrap:wrap;

}


.trust div{

background:white;
padding:20px;
border-radius:15px;

}



/* Footer */

footer{

background:#111;
color:white;
text-align:center;
padding:30px;

}


footer a{

color:white;
margin:10px;

}



/* Mobile */

@media(max-width:900px){

.product-container{

grid-template-columns:repeat(2,1fr);

}

}



@media(max-width:600px){

header{

flex-direction:column;

}


.product-container{

grid-template-columns:1fr;

}


.blog-container{

flex-direction:column;

}


.hero h1{

font-size:28px;

}

}
